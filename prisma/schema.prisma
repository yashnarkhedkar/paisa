generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  // migrations take a session lock; through Neon's pooler the unlock can land on another connection and the
  // lock leaks, hanging every later build. Migrations go direct (Neon URL without "-pooler").
  directUrl = env("DIRECT_URL")
}

enum AccountKind {
  BANK
  CARD
}

// which PDF reader understands this account's statements; null = CSV only
enum StatementFormat {
  BOB
  IDFC
  AXIS
  ICICI
}

enum HoldingKind {
  STOCK
  MF
  GOLD
  FD
}

model Account {
  id           Int           @id @default(autoincrement())
  code         String        @unique
  name         String
  kind         AccountKind
  format       StatementFormat?
  createdAt    DateTime      @default(now())
  transactions Transaction[]
}

model Category {
  id           Int           @id @default(autoincrement())
  name         String        @unique
  isSpending   Boolean       @default(true)
  budget       Decimal?      @db.Decimal(14, 2) // monthly limit; null = no budget
  rules        Rule[]
  transactions Transaction[]
  goals        Goal[]
}

/// Progress = base + net put into `category` on/after `countFrom` (so money already in `base` isn't counted twice).
model Goal {
  id         Int       @id @default(autoincrement())
  name       String
  target     Decimal   @db.Decimal(14, 2)
  base       Decimal   @default(0) @db.Decimal(14, 2)
  countFrom  DateTime  @default(now()) @db.Date
  deadline   DateTime? @db.Date
  categoryId Int?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  createdAt  DateTime  @default(now())
}

/// Known monthly commitments (rent, insurance, SIP...). Manual list; shown on home.
model FixedPayment {
  id        Int      @id @default(autoincrement())
  name      String
  amount    Decimal  @db.Decimal(14, 2)
  createdAt DateTime @default(now())
}

model Rule {
  id         Int      @id @default(autoincrement())
  keyword    String   @unique
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
}

model Transaction {
  id          Int       @id @default(autoincrement())
  accountId   Int
  account     Account   @relation(fields: [accountId], references: [id], onDelete: Cascade)
  date        DateTime  @db.Date
  description String
  amount      Decimal   @db.Decimal(14, 2)
  ref         String?
  categoryId  Int?
  category    Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  hash        String    @unique
  importedAt  DateTime  @default(now())

  @@index([date])
  @@index([accountId, date])
}

model Holding {
  id           Int         @id @default(autoincrement())
  kind         HoldingKind
  symbol       String
  qty          Decimal     @db.Decimal(14, 4)
  avgPrice     Decimal     @db.Decimal(14, 2)
  currentPrice Decimal?    @db.Decimal(14, 2)
  note         String?
  updatedAt    DateTime    @updatedAt

  @@unique([kind, symbol])
}
